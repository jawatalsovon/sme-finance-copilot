# Copy to backend/.env (or $COPILOT_PRIVATE_DIR/.env) and fill in locally. Both are git-ignored /
# outside the repo. Names only here. Precedence: real env > private .env > backend/.env.

# --- Instance ------------------------------------------------------------
# dev | demo | prod. Outside dev, owner actions REQUIRE OWNER_API_TOKEN (fail closed).
APP_ENV=dev
# 1 = same as APP_ENV=demo
DEMO_MODE=0
# Folder OUTSIDE the repo with this instance's .env, companies.json, connectors/ and database.
COPILOT_PRIVATE_DIR=
# Companies + initial tiers (JSON list). Default: $COPILOT_PRIVATE_DIR/companies.json if present.
COMPANIES_FILE=
# Extra connector modules (*.py), comma/;-separated dirs. Default: $COPILOT_PRIVATE_DIR/connectors
CONNECTOR_PLUGIN_DIRS=

# --- LLM runtime ---------------------------------------------------------
# mock (default, $0, deterministic) | openai | anthropic
LLM_PROVIDER=mock
# Model id for the chosen provider, e.g. an OpenAI or Claude model name.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Hard spend caps in USD, enforced before every LLM call.
LLM_DAILY_USD_CAP=1.00
LLM_REQUEST_USD_CAP=0.10
LLM_MAX_OUTPUT_TOKENS=1200
# Optional path to an edited pricing table (defaults to backend/agent/providers/pricing.json)
LLM_PRICING_FILE=

# --- Storage -------------------------------------------------------------
# Relative paths resolve against COPILOT_PRIVATE_DIR if set (default there: copilot.duckdb), else the repo.
DUCKDB_PATH=data/copilot.duckdb
# 1 = load the tiny fictional dev fixture company 'devco' (tests use it; off by default)
SEED_DEV_FIXTURE=0
# 1 = create the three fictional demo SME company rows (bd_grocer, cn_xborder, uk_garden); 0 on a private instance
SEED_DEMO_COMPANIES=1
# Optional data hook used at startup-reset: a module exposing seed(db) -> dict (owner D1)
DEMO_SEED_MODULE=scripts.data.seed
# Pin "today" for business logic (as_of defaults) so scripted runs are reproducible, e.g. 2026-10-20
COPILOT_TODAY=

# --- Test harness (local/dev only) ----------------------------------------
# 1 = enable POST /admin/reset (wipes the DB and reloads the seeded demo state; localhost only)
ADMIN_RESET_ENABLED=0

# --- Security ------------------------------------------------------------
# Tier granted to companies that have no explicit setting: T0 | T1 | T2 | T3
DEFAULT_COMPANY_TIER=T1
# Max T3 (limited execute) actions per company per tool per day
T3_DAILY_CAP=20
# Owner token for approve/reject, tier changes and /admin/reset ("Authorization: Bearer <token>").
# dev: checked only if set. demo/prod: mandatory - without it nobody can do owner actions.
OWNER_API_TOKEN=
# Comma-separated extra names to redact before text reaches the LLM
REDACT_NAMES=

# --- API -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- QuickBooks Online (sandbox only) ------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox
QBO_REDIRECT_URI=http://localhost:8000/connectors/qbo/callback
